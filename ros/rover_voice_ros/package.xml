<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_voice_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 node for the rover voice loop: publishes voice commands, transcripts, and sound direction.</description>
  <maintainer email="kaddoura.ahmad@gmail.com">Ahmad Kaddoura</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>rover_voice_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <!-- The voice loop itself (rover_voice) and its models come from the
       repo's Python environment: scripts/setup.sh, see docs/ros2.md. -->

  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
